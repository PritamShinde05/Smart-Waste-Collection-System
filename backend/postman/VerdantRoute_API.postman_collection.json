  "item": [
    {
      "name": "01. Health",
      "item": [
        {
          "name": "Health Check",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/api/health"
          }
        }
      ]
    },
    {
      "name": "02. Authentication",
      "item": [
        {
          "name": "Register Admin & Municipal Area",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "if (pm.response.code === 201) {",
                  "  const json = pm.response.json();",
                  "  if (json.token) pm.collectionVariables.set('token', json.token);",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Municipal Admin\",\n  \"email\": \"admin@verdantroute.local\",\n  \"mobile\": \"+919800000001\",\n  \"password\": \"AdminPass123!\",\n  \"confirmPassword\": \"AdminPass123!\",\n  \"areaName\": \"Central Zone\",\n  \"city\": \"Pune\",\n  \"centreLat\": 18.5204,\n  \"centreLng\": 73.8567\n}"
            },
            "url": "{{baseUrl}}/api/auth/register-admin"
          }
        },
        {
          "name": "Login (Email or Mobile)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "if (pm.response.code === 200) {",
                  "  const json = pm.response.json();",
                  "  if (json.token) pm.collectionVariables.set('token', json.token);",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"identifier\": \"admin@verdantroute.local\",\n  \"password\": \"AdminPass123!\"\n}"
            },
            "url": "{{baseUrl}}/api/auth/login"
          }
        },
        {
          "name": "Current User (/me)",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }],
            "url": "{{baseUrl}}/api/auth/me"
          }
        },
        {
          "name": "Change Password",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Authorization", "value": "Bearer {{token}}" },
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"currentPassword\": \"AdminPass123!\",\n  \"newPassword\": \"AdminPass456!\",\n  \"confirmPassword\": \"AdminPass456!\"\n}"
            },
            "url": "{{baseUrl}}/api/auth/change-password"
          }
        },
        {
          "name": "Logout",
          "request": {
            "method": "POST",
            "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }],
            "url": "{{baseUrl}}/api/auth/logout"
          }
        }
      ]
    },
    {
      "name": "03. Municipal Area",
      "item": [
        {
          "name": "Get Area Settings",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }],
            "url": "{{baseUrl}}/api/area"
          }
        },
        {
          "name": "Update Area Settings (Admin)",
          "request": {
            "method": "PUT",
            "header": [
              { "key": "Authorization", "value": "Bearer {{token}}" },
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Central Zone\",\n  \"city\": \"Pune\",\n  \"centreLat\": 18.5204,\n  \"centreLng\": 73.8567,\n  \"defaultIntervalSeconds\": 900,\n  \"mediumThreshold\": 50,\n  \"fullThreshold\": 80\n}"
            },
            "url": "{{baseUrl}}/api/area"
          }
        }
      ]
    },
    {
      "name": "04. Sensors & Device Telemetry",
      "item": [
        {
          "name": "List Sensors (Admin)",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }],
            "url": "{{baseUrl}}/api/sensors"
          }
        },
        {
          "name": "Create Sensor (Admin)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "if (pm.response.code === 201) {",
                  "  const json = pm.response.json();",
                  "  if (json.sensor && json.sensor.id) pm.collectionVariables.set('sensorId', String(json.sensor.id));",
                  "  if (json.sensor && json.sensor.binId) pm.collectionVariables.set('binId', json.sensor.binId);",
                  "  if (json.deviceKey) pm.collectionVariables.set('deviceKey', json.deviceKey);",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              { "key": "Authorization", "value": "Bearer {{token}}" },
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"binId\": \"BIN-101\",\n  \"label\": \"Shivajinagar Main Gate\",\n  \"latitude\": 18.5308,\n  \"longitude\": 73.8475,\n  \"binHeightCm\": 120,\n  \"intervalSeconds\": 900,\n  \"fullThreshold\": 80\n}"
            },
            "url": "{{baseUrl}}/api/sensors"
          }
        },
        {
          "name": "Get Sensor Detail (day/week/month)",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }],
            "url": "{{baseUrl}}/api/sensors/{{sensorId}}?range=day"
          }
        },
        {
          "name": "Update Sensor (Admin)",
          "request": {
            "method": "PUT",
            "header": [
              { "key": "Authorization", "value": "Bearer {{token}}" },
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"label\": \"Shivajinagar Gate East\",\n  \"intervalSeconds\": 600,\n  \"fullThreshold\": 85,\n  \"isActive\": true\n}"
            },
            "url": "{{baseUrl}}/api/sensors/{{sensorId}}"
          }
        },
        {
          "name": "Regenerate Sensor Device Key (Admin)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "if (pm.response.code === 200) {",
                  "  const json = pm.response.json();",
                  "  if (json.deviceKey) pm.collectionVariables.set('deviceKey', json.deviceKey);",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }],
            "url": "{{baseUrl}}/api/sensors/{{sensorId}}/regenerate-key"
          }
        },
        {
          "name": "Simulate Sensor Reading (Admin QA)",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Authorization", "value": "Bearer {{token}}" },
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"distanceCm\": 18\n}"
            },
            "url": "{{baseUrl}}/api/sensors/{{sensorId}}/simulate-reading"
          }
        },
        {
          "name": "ESP32 Telemetry Reading (X-Device-Key)",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "X-Device-Key", "value": "{{deviceKey}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"binId\": \"{{binId}}\",\n  \"distanceCm\": 22.5\n}"
            },
            "url": "{{baseUrl}}/api/device/reading"
          }
        },
        {
          "name": "Delete Sensor (Admin)",
          "request": {
            "method": "DELETE",
            "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }],
            "url": "{{baseUrl}}/api/sensors/{{sensorId}}"
          }
        }
      ]
    },
    {
      "name": "05. Dashboard Analytics (Admin)",
      "item": [
