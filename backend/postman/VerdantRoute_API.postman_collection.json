            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"completionNote\": \"All assigned bins cleared and returned to depot.\"\n}"
            },
            "url": "{{baseUrl}}/api/employee/tasks/{{taskId}}/complete"
          }
        }
      ]
    },
