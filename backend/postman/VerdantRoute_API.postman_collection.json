        {
          "name": "Mark Stop Bin Collected",
          "request": {
            "method": "PATCH",
            "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }],
            "url": "{{baseUrl}}/api/employee/tasks/{{taskId}}/bins/{{taskBinId}}/collect"
          }
