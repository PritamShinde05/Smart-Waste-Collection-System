{
  "info": {
    "name": "VerdantRoute Smart Waste Collection API",
    "_postman_id": "a4c9f8b2-1d63-4e20-8a7e-7731c0b9a110",
    "description": "Complete Postman v2.1 collection for the official Java 17 + Spring Boot 3.4 + MySQL 8 backend (/backend).",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    { "key": "baseUrl", "value": "http://localhost:8080" },
    { "key": "token", "value": "" },
    { "key": "deviceKey", "value": "" },
    { "key": "binId", "value": "BIN-101" },
    { "key": "sensorId", "value": "1" },
    { "key": "employeeId", "value": "2" },
    { "key": "taskId", "value": "1" },
