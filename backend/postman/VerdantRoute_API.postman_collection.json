              "raw": "{\n  \"name\": \"Rohan Patil\",\n  \"email\": \"rohan@verdantroute.local\",\n  \"mobile\": \"+919811112222\",\n  \"password\": \"DriverPass123!\",\n  \"status\": \"ACTIVE\"\n}"
            },
            "url": "{{baseUrl}}/api/employees"
          }
        },
        {
          "name": "Update Employee",
          "request": {
            "method": "PUT",
            "header": [
              { "key": "Authorization", "value": "Bearer {{token}}" },
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Rohan Patil\",\n  \"email\": \"rohan@verdantroute.local\",\n  \"mobile\": \"+919811112222\",\n  \"status\": \"ACTIVE\"\n}"
            },
            "url": "{{baseUrl}}/api/employees/{{employeeId}}"
          }
        },
        {
          "name": "Toggle Employee Status",
          "request": {
            "method": "PATCH",
            "header": [
              { "key": "Authorization", "value": "Bearer {{token}}" },
