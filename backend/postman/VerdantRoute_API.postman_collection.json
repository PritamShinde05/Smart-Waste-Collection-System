            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"status\": \"ACTIVE\"\n}"
            },
            "url": "{{baseUrl}}/api/employees/{{employeeId}}/status"
          }
        },
        {
          "name": "Reset Employee Password",
          "request": {
            "method": "PATCH",
            "header": [
              { "key": "Authorization", "value": "Bearer {{token}}" },
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"newPassword\": \"DriverPass456!\"\n}"
            },
            "url": "{{baseUrl}}/api/employees/{{employeeId}}/reset-password"
          }
        },
        {
          "name": "Get Employee Task History",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }],
            "url": "{{baseUrl}}/api/employees/{{employeeId}}/history"
          }
        }
      ]
    },
    {
      "name": "07. Routes & Tasks (Admin)",
      "item": [
        {
          "name": "Preview OSRM Optimized Route",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Authorization", "value": "Bearer {{token}}" },
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"startType\": \"DEPOT\",\n  \"employeeId\": {{employeeId}},\n  \"sensorIds\": [{{sensorId}}],\n  \"returnToDepot\": true\n}"
            },
            "url": "{{baseUrl}}/api/routes/preview"
          }
        },
        {
          "name": "Create & Assign Task",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "if (pm.response.code === 201) {",
                  "  const json = pm.response.json();",
                  "  if (json.task && json.task.id) pm.collectionVariables.set('taskId', String(json.task.id));",
                  "  if (json.task && json.task.stops && json.task.stops.length > 0) {",
                  "    pm.collectionVariables.set('taskBinId', String(json.task.stops[0].taskBinId));",
                  "  }",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              { "key": "Authorization", "value": "Bearer {{token}}" },
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"employeeId\": {{employeeId}},\n  \"sensorIds\": [{{sensorId}}],\n  \"startType\": \"DEPOT\",\n  \"note\": \"Morning priority collection\",\n  \"returnToDepot\": true\n}"
            },
            "url": "{{baseUrl}}/api/tasks"
          }
        },
        {
          "name": "List Tasks",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }],
            "url": "{{baseUrl}}/api/tasks"
          }
        },
        {
          "name": "Get Task Detail",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }],
            "url": "{{baseUrl}}/api/tasks/{{taskId}}"
          }
        },
        {
          "name": "Reoptimize Task Route",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Authorization", "value": "Bearer {{token}}" },
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"startType\": \"DEPOT\",\n  \"returnToDepot\": true\n}"
            },
            "url": "{{baseUrl}}/api/tasks/{{taskId}}/reoptimize"
          }
        },
        {
          "name": "Cancel Task",
          "request": {
            "method": "PATCH",
            "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }],
            "url": "{{baseUrl}}/api/tasks/{{taskId}}/cancel"
          }
        }
      ]
    },
    {
      "name": "08. Employee Workflow & GPS",
      "item": [
        {
          "name": "List My Assigned Tasks",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }],
            "url": "{{baseUrl}}/api/employee/tasks"
