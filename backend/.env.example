# VerdantRoute Java Spring Boot + MySQL Environment Variables
# Copy or export these variables in your shell before running `mvn spring-boot:run`.
# Never commit real credentials or secrets to Git.

SERVER_PORT=8080
DB_HOST=localhost
DB_PORT=3306
DB_NAME=smart_waste_db
DB_USERNAME=root
DB_PASSWORD=
DB_USE_SSL=false

# Generate a strong 32+ character secret (e.g. `openssl rand -hex 32`)
JWT_SECRET=

# Allowed React frontend origins
CORS_ORIGINS=http://localhost:3000,http://localhost:5173

# Self-hosted or managed OSRM instance URL
OSRM_BASE_URL=https://router.project-osrm.org
OSRM_MAX_WAYPOINTS=50
OSRM_TIMEOUT_SECONDS=12
