# GEMINI_API_KEY: Optional AI Studio environment variable.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"

# Official Production Backend (Java Spring Boot + MySQL)
# Never commit real passwords or secrets into version control or .env.local.
DB_HOST="localhost"
DB_PORT="3306"
DB_NAME="smart_waste_db"
DB_USERNAME="root"
DB_PASSWORD=""
DB_USE_SSL="false"
JWT_SECRET=""

# Road Routing Provider (point to self-hosted OSRM in production, e.g. http://localhost:5000)
OSRM_BASE_URL="https://router.project-osrm.org"
OSRM_MAX_WAYPOINTS="50"

# Frontend API targets when connecting React (port 3000) to standalone Spring Boot (port 8080)
VITE_API_BASE_URL=""
VITE_WS_BASE_URL=""
