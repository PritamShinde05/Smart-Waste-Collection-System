# GEMINI_API_KEY: Optional AI Studio environment variable.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"

# JWT_SECRET: Signing key for authentication tokens (in-memory secure fallback if unset in dev).
JWT_SECRET=""

# SPRING_BOOT_MYSQL_CONFIG (for backend/ Spring Boot + MySQL deployment)
DB_HOST="localhost"
DB_PORT="3306"
DB_NAME="smart_waste_db"
DB_USERNAME="root"
DB_PASSWORD=""

# Optional frontend override to point directly at a standalone Spring Boot backend (e.g. http://localhost:8080)
VITE_API_BASE_URL=""
VITE_WS_BASE_URL=""
